#!/bin/bash
set -xeuo pipefail

[ "$1" = "final" ] || exit 0

mkosi-chroot git clone --depth 1 https://github.com/ASPP/installation /root/installation

# This does not enable the ansible timers. If this is desired, please use the second playbook command or apply manually

mkosi-chroot ansible-playbook -i localhost, --connection local /root/installation/setup-ansible.yml

# mkosi-chroot ansible-playbook -i localhost, --connection local /root/installation/setup-ansible.yml -e ansible_pull_timer_enabled=True

# systemctl --root="$BUILDROOT" enable ansible-pull-init.timer ansible-pull-repeat.timer
